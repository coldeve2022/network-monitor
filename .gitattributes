# 统一换行符处理，避免 Windows/Linux 混用产生无意义的整文件 diff
* text=auto

# Windows 脚本必须保留 CRLF，否则 cmd 解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.exe   binary
*.dll   binary
*.ico   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.db    binary
*.zip   binary

# 文本文件正常识别
*.py    text
*.js    text
*.css   text
*.html  text
*.json  text
*.md    text
*.txt   text
*.spec  text

# Release 附件不打进源码归档
*.exe   export-ignore
